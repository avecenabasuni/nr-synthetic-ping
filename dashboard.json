            "nrqlQueries": [
              {
                "accountIds": [9999999],
                "query": "FROM HostPing SELECT average(lossPct) AS 'Avg Loss (%)', percentile(rttP95Ms, 95) AS 'p95 RTT (ms)' SINCE 24 hours ago TIMESERIES 15 minutes FACET host LIMIT 50"
