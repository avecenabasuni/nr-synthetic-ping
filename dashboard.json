        },
        {
          "id": "498733292",
          "title": "Availability (7d)",
          "layout": { "column": 1, "row": 9, "width": 4, "height": 3 },
          "linkedEntityGuids": [],
          "visualization": { "id": "viz.table" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [9999999],
                "query": "FROM HostPing SELECT filter(count(*), WHERE status = 'Up') / count(*) * 100 AS 'Availability (%)' SINCE 7 days ago FACET host LIMIT MAX"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false },
            "thresholds": [
              { "columnName": "Availability (%)", "from": 95, "severity": "success", "to": 100 },
              { "columnName": "Availability (%)", "from": 80, "severity": "warning", "to": 95 },
              { "columnName": "Availability (%)", "from": 0, "severity": "critical", "to": 80 }
            ]
          }
        },
        {
          "id": "498733234",
          "title": "Avg Loss & p95 (24h)",
          "layout": { "column": 5, "row": 9, "width": 4, "height": 3 },
          "linkedEntityGuids": [],
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "markers": {
