        {
          "id": "498725593",
          "title": "Server Health",
          "layout": { "column": 1, "row": 2, "width": 12, "height": 3 },
          "linkedEntityGuids": [],
          "visualization": { "id": "viz.table" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [9999999],
                "query": "FROM HostPing SELECT latest(severity) AS 'Severity', latest(status) AS 'Status', latest(lossPct) AS 'Loss (%)', latest(rttP95Ms) AS 'p95 RTT (ms)', if(latest(rttP95Ms) >= 250 OR latest(lossPct) >= 30, '🔴', if(latest(rttP95Ms) >= 120 OR latest(lossPct) >= 10, '🟡', '🟢')) AS 'Health', if(latest(status) = 'Up', if(filter(count(*), WHERE status != 'Up') > 0, floor((max(timestamp) - filter(max(timestamp), WHERE status != 'Up')) / 60000), floor((max(timestamp) - min(timestamp)) / 60000)), 0) AS 'Up for (min)', if(latest(status) != 'Up', if(filter(count(*), WHERE status = 'Up') > 0, floor((max(timestamp) - filter(max(timestamp), WHERE status = 'Up')) / 60000), floor((max(timestamp) - min(timestamp)) / 60000)), 0) AS 'Non-Up for (min)', latest(lastError) AS 'Last Error' SINCE 30 days ago FACET host LIMIT MAX"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false },
            "thresholds": [
              { "columnName": "Loss (%)", "from": 0, "severity": "success", "to": 10 },
              { "columnName": "Loss (%)", "from": 10, "severity": "critical", "to": 100 }
            ]
          }
        },
        {
          "id": "498733204",
          "title": "Top Issues",
          "layout": { "column": 1, "row": 5, "width": 12, "height": 3 },
          "linkedEntityGuids": [],
          "visualization": { "id": "viz.table" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [9999999],
                "query": "FROM HostPing SELECT latest(lossPct) AS 'Loss (%)', latest(rttP95Ms) AS 'p95 RTT (ms)', latest(status) AS 'Status', latest(severity) AS 'Severity', latest(lastError) AS 'Last Error' SINCE 24 hours ago FACET host LIMIT 20"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false },
            "thresholds": [
              { "columnName": "Loss (%)", "from": 0, "severity": "success", "to": 80 },
              { "columnName": "Loss (%)", "from": 80, "severity": "warning", "to": 95 },
              { "columnName": "Loss (%)", "from": 95, "severity": "critical", "to": 100 }
            ]
          }
        },
        {
